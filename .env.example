VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_WORKOS_CLIENT_ID=client_your_workos_client_id
VITE_WORKOS_API_HOSTNAME=api.workos.com
# Optional; app uses `${origin}/auth/callback` at runtime. Register both
# http://localhost:5173/auth/callback and https://moshko.pages.dev/auth/callback
# in the WorkOS dashboard.
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
# Required until a WorkOS custom auth domain is set (refresh token in localStorage).
VITE_WORKOS_DEV_MODE=true
